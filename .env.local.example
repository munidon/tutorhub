# ─────────────────────────────────────────────────────────────
# TutorHub 환경변수 템플릿
# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요.
#   cp .env.local.example .env.local
# Supabase 대시보드 > Project Settings > API 에서 값 확인.
# ─────────────────────────────────────────────────────────────

# 공개(클라이언트 노출 OK)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 서버 전용(절대 클라이언트에 노출 금지) — 학부모 계정 발급(admin API)에 사용
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# 학부모 로그인 ID → 합성 이메일 매핑 도메인 (이메일 없는 학부모용)
NEXT_PUBLIC_PARENT_EMAIL_DOMAIN=parents.tutorhub.local

# 배포 URL (Telegram 딥링크/리다이렉트에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram 알림 (Edge Function 에서 사용 — Supabase Function Secrets 로 등록 권장)
# TELEGRAM_BOT_TOKEN=123456:ABC...
